<?xml version="1.0" encoding="utf-8"?>
<!-- Android 12+. Same allow-list for cloud backup and device-to-device transfer; secrets never leave the device. -->
<data-extraction-rules>
    <cloud-backup>
        <include domain="sharedpref" path="pallas_launcher_prefs.xml" />
        <include domain="sharedpref" path="pallas_screens.xml" />
    </cloud-backup>
    <device-transfer>
        <include domain="sharedpref" path="pallas_launcher_prefs.xml" />
        <include domain="sharedpref" path="pallas_screens.xml" />
    </device-transfer>
</data-extraction-rules>