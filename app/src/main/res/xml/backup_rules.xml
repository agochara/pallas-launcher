<?xml version="1.0" encoding="utf-8"?>
<!-- Android 11 and lower. Explicit allow-list: ONLY settings + screens are backed up.
     Usage history, UI state and the secrets file (pallas_secrets: API keys) are deliberately excluded. -->
<full-backup-content>
    <include domain="sharedpref" path="pallas_launcher_prefs.xml" />
    <include domain="sharedpref" path="pallas_screens.xml" />
</full-backup-content>